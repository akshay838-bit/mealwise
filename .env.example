WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_APP_SECRET=from-meta-app-settings
WHATSAPP_ACCESS_TOKEN=from-meta-whatsapp-api-setup
WHATSAPP_PHONE_NUMBER_ID=from-meta-whatsapp-api-setup
OWNER_PHONE=country-code-and-number-without-plus
COOK_PHONE=country-code-and-number-without-plus
# Grocery policy: separate (default) or meal_plan
GROCERY_APPROVAL_MODE=separate
# ₹1,000 inclusive of fees; amounts stored in paisa
GROCERY_MAX_TOTAL_PAISE=100000
# Separate, randomly generated credential for the Codex grocery queue bridge
GROCERY_EXECUTOR_TOKEN=configure-as-production-secret
